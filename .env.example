# Forecast API (read by api/config.py): path to the model checkpoint, relative to the project root.
# The default checkpoint is included in the repo; to use your own, create it with ML_layer/prepare_checkpoint.py
CHECKPOINT_PATH=artifacts/checkpoints/best_mlflow_checkpoint.ckpt
# Optional: the API rebuilds the VIX feature from yfinance without it. Needed only for models using other FRED features.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=replace-with-your-fred-key


# Optional cloud LLMs for the chat UI. A provider shows up in the model picker only when its key is set.
# OPENAI_API_KEY=replace-with-your-openai-key
# OPENAI_MODELS=gpt-5,gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# MLflow tracking server used by training
MLFLOW_TRACKING_URI=http://localhost:5000

# DagsHub repository that receives MLflow experiments and checkpoint artifacts.
DAGSHUB_REPO_OWNER=your-dagshub-username
DAGSHUB_REPO_NAME=simple-alpha

# Create a token at https://dagshub.com/user/settings/tokens and keep it local.
DAGSHUB_USER_TOKEN=replace-with-your-token

# user agent for getting data from SEC EDGAR is required to avoid being blocked. It should be your name and email address.
# SEC_USER_AGENT=Jane Doe jane.doe@example.com

# Default mlflow run id used in prepare_checkpoint.py if nothing else is specified, set this after running training
# MLFLOW_RUN_ID=run-id

# URLs for the MCP and LLM used when testing the MCP tools
MCP_URL=http://127.0.0.1:8001/mcp
LLM_URL=http://127.0.0.1:8080/v1

# Browser origins allowed to use the chat socket (comma separated). Only needed if you serve the UI from another address.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
